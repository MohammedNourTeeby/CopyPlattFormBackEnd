{
  "kind": "collectionType",
  "collectionName": "user_profiles",
  "info": {
    "singularName": "user-profile",
    "pluralName": "user-profiles",
    "displayName": "UserProfile"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "bio": {
      "type": "blocks"
    },
    "profileImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "jobTitle": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "isMultiFactorAuthEnabled": {
      "type": "boolean"
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "username": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "facebookLink": {
      "type": "string"
    }
  }
}
