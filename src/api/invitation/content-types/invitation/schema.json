{
  "kind": "collectionType",
  "collectionName": "invitations",
  "info": {
    "singularName": "invitation",
    "pluralName": "invitations",
    "displayName": "Invitation"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "student_email": {
      "type": "email",
      "required": true
    },
    "statu": {
      "type": "enumeration",
      "default": "'pending'",
      "enum": [
        "'sent'",
        "'completed'",
        "'pending'"
      ]
    },
    "assessment": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::assessment.assessment",
      "inversedBy": "invitations"
    }
  }
}
